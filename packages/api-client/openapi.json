			"patch": {
				"operationId": "GroupsController_update",
				"parameters": [
					{
						"name": "id",
						"required": true,
						"in": "path",
						"schema": { "type": "number" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/UpdateGroupDto" }
						}
					}
				},
				"responses": { "200": { "description": "" } },
				"security": [{ "bearer": [] }],
				"summary": "Update a group; pass regenerateSessions=true to regenerate future sessions from new schedule",
				"tags": ["Manage / Groups"]
			}
		},
		"/api/v1/manage/groups/{id}/enrollments": {
			"get": {
				"operationId": "GroupsController_listEnrollments",
				"parameters": [
					{
						"name": "id",
						"required": true,
						"in": "path",
						"schema": { "type": "number" }
					},
					{
						"name": "status",
						"required": false,
						"in": "query",
						"schema": {
							"type": "string",
							"enum": ["ACTIVE", "DROPPED", "COMPLETED", "TRANSFERRED"]
						}
					}
				],
				"responses": { "200": { "description": "" } },
				"security": [{ "bearer": [] }],
				"summary": "List a group's enrolled students (optional ?status=ACTIVE)",
				"tags": ["Manage / Groups"]
			},
			"post": {
				"operationId": "GroupsController_enroll",
				"parameters": [
					{
						"name": "id",
						"required": true,
						"in": "path",
						"schema": { "type": "number" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/EnrollStudentsDto" }
						}
					}
				},
				"responses": { "201": { "description": "" } },
				"security": [{ "bearer": [] }],
				"summary": "Batch-enroll students into a group; returns 409 if group is at capacity",
				"tags": ["Manage / Groups"]
			}
		},
		"/api/v1/manage/groups/{id}/sessions": {
			"get": {
				"operationId": "GroupsController_listSessions",
				"parameters": [
					{
						"name": "id",
						"required": true,
						"in": "path",
						"schema": { "type": "number" }
					},
					{
						"name": "from",
						"required": false,
						"in": "query",
						"schema": { "example": "2025-01-01", "type": "string" }
					},
					{
						"name": "to",
						"required": false,
						"in": "query",
						"schema": { "example": "2025-06-30", "type": "string" }
					},
					{
						"name": "status",
						"required": false,
						"in": "query",
						"schema": {
							"type": "string",
							"enum": ["SCHEDULED", "COMPLETED", "CANCELLED"]
						}
					}
				],
				"responses": { "200": { "description": "" } },
				"security": [{ "bearer": [] }],
				"summary": "List a group's sessions (optional ?from=&to=&status=)",
				"tags": ["Manage / Groups"]
			}
		},
		"/api/v1/manage/sessions": {
			"get": {
				"operationId": "SessionsController_calendar",
				"parameters": [
					{
						"name": "branchId",
						"required": false,
						"in": "query",
						"schema": { "type": "number" }
					},
					{
						"name": "from",
						"required": true,
						"in": "query",
						"description": "Required. Start of calendar window.",
						"schema": { "example": "2025-01-01", "type": "string" }
					},
					{
						"name": "to",
						"required": true,
						"in": "query",
						"description": "Required. End of window (max 90 days).",
						"schema": { "example": "2025-03-31", "type": "string" }
					},
					{
						"name": "teacherId",
						"required": false,
						"in": "query",
						"description": "FK to staff.id",
						"schema": { "type": "number" }
					},
					{
						"name": "roomId",
						"required": false,
						"in": "query",
						"schema": { "type": "number" }
					},
					{
						"name": "status",
						"required": false,
						"in": "query",
						"schema": {
							"type": "string",
							"enum": ["SCHEDULED", "COMPLETED", "CANCELLED"]
						}
					}
				],
				"responses": { "200": { "description": "" } },
				"security": [{ "bearer": [] }],
				"summary": "Calendar: sessions across all accessible groups in a date window (from + to required, max 90 days)",
				"tags": ["Manage / Sessions"]
			}
		},
		"/api/v1/manage/sessions/{id}": {
			"get": {
				"operationId": "SessionsController_findOne",
				"parameters": [
					{
						"name": "id",
						"required": true,
						"in": "path",
						"schema": { "type": "number" }
					}
				],
				"responses": { "200": { "description": "" } },
				"security": [{ "bearer": [] }],
				"summary": "Get full session detail including the enrolled student roster",
				"tags": ["Manage / Sessions"]
			},
			"patch": {
				"operationId": "SessionsController_update",
				"parameters": [
					{
						"name": "id",
						"required": true,
						"in": "path",
						"schema": { "type": "number" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/UpdateSessionDto" }
						}
					}
				},
				"responses": { "200": { "description": "" } },
				"security": [{ "bearer": [] }],
				"summary": "Update a session (reschedule / room change / substitute / cancel). CANCELLED requires cancellationReason; room/teacher changes are conflict-checked (409 on double-book).",
				"tags": ["Manage / Sessions"]
			}
		},
		"/api/v1/manage/enrollments/{id}": {
			"get": {
				"operationId": "EnrollmentsController_findOne",
				"parameters": [
					{
						"name": "id",
						"required": true,
						"in": "path",
						"schema": { "type": "number" }
					}
				],
				"responses": { "200": { "description": "" } },
				"security": [{ "bearer": [] }],
				"summary": "Get enrollment detail",
				"tags": ["Manage / Enrollments"]
			},
			"patch": {
				"operationId": "EnrollmentsController_update",
				"parameters": [
					{
						"name": "id",
						"required": true,
						"in": "path",
						"schema": { "type": "number" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/UpdateEnrollmentDto"
							}
						}
					}
				},
				"responses": { "200": { "description": "" } },
				"security": [{ "bearer": [] }],
				"summary": "Update enrollment status (DROPPED / COMPLETED / TRANSFERRED). DROPPED requires dropReason.",
				"tags": ["Manage / Enrollments"]
			}
		}
	},
	"info": {
		"title": "EduCore",
		"description": "EduCore API description.",
		"version": "1.0",
		"contact": {}
	},
	"tags": [],
	"servers": [],
	"components": {
		"securitySchemes": {
			"bearer": { "scheme": "bearer", "bearerFormat": "JWT", "type": "http" }
		},
		"schemas": {
			"LoginDto": {
				"type": "object",
				"properties": {
					"phone": {
						"type": "string",
						"example": "+998901234567",
						"description": "E.164 phone number"
					},
					"password": { "type": "string", "example": "S3cret-pass" }
				},
				"required": ["phone", "password"]
			},
			"RefreshTokenDto": {
				"type": "object",
				"properties": {
					"refreshToken": {
						"type": "string",
						"description": "A valid refresh token previously issued by login or refresh."
					}
				},
				"required": ["refreshToken"]
			},
			"EmergencyContactDto": {
				"type": "object",
				"properties": {
					"name": { "type": "string" },
					"phone": { "type": "string" },
					"relation": { "type": "string" }
				},
				"required": ["name", "phone", "relation"]
			},
			"CreateStudentDto": {
				"type": "object",
				"properties": {
					"branchId": { "type": "number" },
					"firstName": { "type": "string" },
					"lastName": { "type": "string" },
					"phone": {
						"type": "string",
						"example": "+998901234567",
						"description": "E.164 phone number"
					},
					"email": { "type": "string" },
					"dateOfBirth": {
						"type": "string",
						"example": "2008-05-01",
						"description": "YYYY-MM-DD"
					},
					"gender": { "type": "string", "enum": ["M", "F", "O"] },
					"address": { "type": "string" },
					"emergencyContact": {
						"$ref": "#/components/schemas/EmergencyContactDto"
					},
					"notes": { "type": "string" }
				},
				"required": ["branchId", "firstName", "lastName", "phone"]
			},
			"UpdateStudentDto": {
				"type": "object",
				"properties": {
					"branchId": { "type": "number" },
					"dateOfBirth": {
						"type": "string",
						"example": "2008-05-01",
						"description": "YYYY-MM-DD"
					},
					"gender": { "type": "string", "enum": ["M", "F", "O"] },
					"address": { "type": "string" },
					"emergencyContact": {
						"$ref": "#/components/schemas/EmergencyContactDto"
					},
					"notes": { "type": "string" },
					"status": {
						"type": "string",
						"enum": ["ACTIVE", "INACTIVE", "GRADUATED", "SUSPENDED"]
					}
				}
			},
			"AddGuardianDto": {
				"type": "object",
				"properties": {
					"phone": {
						"type": "string",
						"example": "+998901234567",
						"description": "E.164 phone number"
					},
					"firstName": {
						"type": "string",
						"description": "Required only when phone is a new user"
					},
					"lastName": {
						"type": "string",
						"description": "Required only when phone is a new user"
					},
					"relation": {
						"type": "string",
						"enum": ["mother", "father", "guardian"]
					},
					"isPrimary": { "type": "boolean", "default": false },
					"canPickup": { "type": "boolean", "default": true }
				},
				"required": ["phone", "relation"]
			},
			"CreateStaffDto": {
				"type": "object",
				"properties": {
					"branchId": { "type": "number" },
					"firstName": { "type": "string" },
					"lastName": { "type": "string" },
					"phone": {
						"type": "string",
						"example": "+998901234567",
						"description": "E.164 phone number"
					},
					"email": { "type": "string" },
					"department": { "type": "string" },
					"specialization": {
						"example": ["IELTS", "General English"],
						"type": "array",
						"items": { "type": "string" }
					},
					"hireDate": {
						"type": "string",
						"example": "2024-09-01",
						"description": "YYYY-MM-DD"
					},
					"employmentType": {
						"type": "string",
						"enum": ["FULL_TIME", "PART_TIME", "CONTRACTOR"]
					},
					"baseSalary": { "type": "number", "minimum": 0 },
					"roleName": {
						"type": "string",
						"description": "Default: TEACHER. Also ADMIN or MANAGER."
					}
				},
				"required": ["branchId", "firstName", "lastName", "phone"]
			},
			"UpdateStaffDto": {
				"type": "object",
				"properties": {
					"branchId": { "type": "number" },
					"department": { "type": "string" },
					"specialization": {
						"example": ["IELTS", "General English"],
						"type": "array",
						"items": { "type": "string" }
					},
					"employmentType": {
						"type": "string",
						"enum": ["FULL_TIME", "PART_TIME", "CONTRACTOR"]
					},
					"baseSalary": { "type": "number", "minimum": 0 },
					"status": {
						"type": "string",
						"enum": ["ACTIVE", "ON_LEAVE", "TERMINATED"]
					}
				}
			},
			"CreateBranchDto": {
				"type": "object",
				"properties": {
					"name": { "type": "string" },
					"code": {
						"type": "string",
						"example": "BR-002",
						"description": "Unique per tenant"
					},
					"address": { "type": "string" },
					"phone": { "type": "string" },
					"email": { "type": "string" },
					"timezone": {
						"type": "string",
						"example": "Asia/Tashkent",
						"description": "Overrides tenant default"
					},
					"isMain": {
						"type": "boolean",
						"default": false,
						"description": "Only one branch can be main"
					}
				},
				"required": ["name", "code"]
			},
			"UpdateBranchDto": {
				"type": "object",
				"properties": {
					"name": { "type": "string" },
					"address": { "type": "string" },
					"phone": { "type": "string" },
					"email": { "type": "string" },
					"timezone": {
						"type": "string",
						"example": "Asia/Tashkent",
						"description": "Overrides tenant default"
					},
					"isMain": {
						"type": "boolean",
						"default": false,
						"description": "Only one branch can be main"
					},
					"isActive": { "type": "boolean" }
				}
			},
			"CreateCourseDto": {
				"type": "object",
				"properties": {
					"branchId": {
						"type": "number",
						"nullable": true,
						"description": "Null = shared across branches"
					},
					"name": { "type": "string" },
					"description": { "type": "string", "nullable": true },
					"level": {
						"type": "string",
						"nullable": true,
						"example": "Beginner"
					},
					"defaultDurationWeeks": { "type": "number", "nullable": true }
				},
				"required": ["name"]
			},
			"UpdateCourseDto": {
				"type": "object",
				"properties": {
					"branchId": { "type": "number", "nullable": true },
					"name": { "type": "string" },
					"description": { "type": "string", "nullable": true },
					"level": { "type": "string", "nullable": true },
					"defaultDurationWeeks": { "type": "number", "nullable": true },
					"isActive": { "type": "boolean" }
				}
			},
			"CreateRoomDto": {
				"type": "object",
				"properties": {
					"branchId": { "type": "number" },
					"name": { "type": "string" },
					"capacity": { "type": "number", "minimum": 1 },
					"type": {
						"type": "string",
						"enum": ["classroom", "lab", "online"],
						"nullable": true
					}
				},
				"required": ["branchId", "name", "capacity"]
			},
			"UpdateRoomDto": {
				"type": "object",
				"properties": {
					"branchId": { "type": "number" },
					"name": { "type": "string" },
					"capacity": { "type": "number", "minimum": 1 },
					"type": {
						"type": "string",
						"enum": ["classroom", "lab", "online"],
						"nullable": true
					},
					"isActive": { "type": "boolean" }
				}
			},
			"ScheduleRuleDto": {
				"type": "object",
				"properties": {
					"days": {
						"type": "array",
						"items": {
							"type": "string",
							"enum": ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"]
						}
					},
					"startTime": { "type": "string", "example": "09:00" },
					"endTime": { "type": "string", "example": "10:30" }
				},
				"required": ["days", "startTime", "endTime"]
			},
			"CreateGroupDto": {
				"type": "object",
				"properties": {
					"branchId": { "type": "number" },
					"courseId": { "type": "number" },
					"defaultTeacherId": {
						"type": "number",
						"nullable": true,
						"description": "FK to staff.id"
					},
					"roomId": { "type": "number", "nullable": true },
					"name": { "type": "string", "example": "IELTS Morning A" },
					"capacity": { "type": "number", "nullable": true, "minimum": 1 },
					"startDate": {
						"type": "string",
						"nullable": true,
						"example": "2025-03-01"
					},
					"endDate": {
						"type": "string",
						"nullable": true,
						"example": "2025-06-30"
					},
					"scheduleRule": {
						"nullable": true,
						"type": "object",
						"allOf": [{ "$ref": "#/components/schemas/ScheduleRuleDto" }]
					}
				},
				"required": ["branchId", "courseId", "name"]
			},
			"UpdateGroupDto": {
				"type": "object",
				"properties": {
					"defaultTeacherId": {
						"type": "number",
						"nullable": true,
						"description": "FK to staff.id"
					},
					"roomId": { "type": "number", "nullable": true },
					"name": { "type": "string" },
					"capacity": { "type": "number", "nullable": true, "minimum": 1 },
					"startDate": { "type": "string", "nullable": true },
					"endDate": { "type": "string", "nullable": true },
					"scheduleRule": {
						"nullable": true,
						"type": "object",
						"allOf": [{ "$ref": "#/components/schemas/ScheduleRuleDto" }]
					},
					"status": {
						"type": "string",
						"enum": ["PLANNED", "ACTIVE", "COMPLETED", "CANCELLED"]
					},
					"regenerateSessions": {
						"type": "boolean",
						"description": "Regenerate future SCHEDULED sessions from the updated schedule rule"
					}
				}
			},
			"EnrollStudentsDto": {
				"type": "object",
				"properties": {
					"studentIds": {
						"description": "Array of student IDs for batch enrollment",
						"type": "array",
						"items": { "type": "number" }
					},
					"feePlanId": {
						"type": "number",
						"nullable": true,
						"description": "Per-enrollment fee plan override"
					}
				},
				"required": ["studentIds"]
			},
			"UpdateSessionDto": {
				"type": "object",
				"properties": {
					"sessionDate": {
						"type": "string",
						"example": "2025-03-20",
						"description": "Reschedule date"
					},
					"startTime": { "type": "string", "example": "09:00" },
					"endTime": { "type": "string", "example": "10:30" },
					"roomId": {
						"type": "number",
						"nullable": true,
						"description": "Room change"
					},
					"teacherId": {
						"type": "number",
						"nullable": true,
						"description": "Substitute teacher (FK to staff.id)"
					},
					"topic": { "type": "string", "nullable": true },
					"status": {
						"type": "string",
						"enum": ["SCHEDULED", "COMPLETED", "CANCELLED"],
						"description": "CANCELLED requires cancellationReason"
					},
					"cancellationReason": {
						"type": "string",
						"nullable": true,
						"description": "Required when status = CANCELLED"
					}
				}
			},
			"UpdateEnrollmentDto": {
				"type": "object",
				"properties": {
					"status": {
						"type": "string",
						"enum": ["DROPPED", "COMPLETED", "TRANSFERRED"],
						"description": "DROPPED requires dropReason. TRANSFERRED: create new enrollment separately."
					},
					"dropReason": {
						"type": "string",
						"nullable": true,
						"description": "Required when status = DROPPED"
					}
				},
				"required": ["status"]
			}
		}
	}
}
