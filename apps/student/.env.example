# Cohort Student App — environment (Vite). Copy to `.env` and adjust.
# Only VITE_-prefixed vars are exposed to the bundle; never put secrets here.
#
# The app is served from one fixed host per environment
# (prod: https://student.cohort.uz); the education center is resolved by the
# backend from the logged-in user.

# Backend origin. The client appends `/api/v1/<surface>`.
# prod: https://api.cohort.uz
VITE_API_ORIGIN=http://localhost:5050

# development | staging | production
VITE_APP_ENV=development
