# EduCore Staff Console — environment (Vite). Copy to `.env` and adjust.
# Only VITE_-prefixed vars are exposed to the bundle; never put secrets here.

# Backend origin. The client appends `/api/v1/<surface>`.
VITE_API_ORIGIN=http://localhost:5050

# development | staging | production
VITE_APP_ENV=development

# Local tenant override when not browsing on a *.localhost subdomain.
# e.g. set to "zabon" and browse localhost:5174; lib/tenant.ts uses this.
# VITE_DEV_TENANT=zabon
