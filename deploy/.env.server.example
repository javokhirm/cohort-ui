# Per-stack config for docker-compose.web.yml. Copy to /opt/cohort/web-prod/.env
# and /opt/cohort/web-dev/.env on the VPS (chmod 600, consistent with the API
# stacks). Nothing here is secret — image refs and network aliases only; the
# SPAs themselves hold no runtime env at all (VITE_* is baked at build time).

# ---------- web-prod (/opt/cohort/web-prod/.env) ----------
COMPOSE_PROJECT_NAME=cohort-web-prod
ADMIN_ALIAS=web-admin
INTERNAL_ALIAS=web-internal
# Fallback tags for a manual `docker compose up`; the deploy workflow overrides
# these with exact git-SHA tags at deploy time.
ADMIN_IMAGE=ghcr.io/<github-owner>/cohort-web-admin:latest
INTERNAL_IMAGE=ghcr.io/<github-owner>/cohort-web-internal:latest

# ---------- web-dev (/opt/cohort/web-dev/.env) ----------
# COMPOSE_PROJECT_NAME=cohort-web-dev
# ADMIN_ALIAS=web-admin-dev
# INTERNAL_ALIAS=web-internal-dev
# ADMIN_IMAGE=ghcr.io/<github-owner>/cohort-web-admin:dev
# INTERNAL_IMAGE=ghcr.io/<github-owner>/cohort-web-internal:dev
